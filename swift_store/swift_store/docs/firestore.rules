rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    function isActive() {
      // Robust check for DEV environment where claims and docs might be missing
      return request.auth.token.get('active', true) == true &&
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'ACTIVE') == 'ACTIVE');
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // P0: Private Account Data - restricted to Owner/Admin
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        // P0-B: Prevent forgery of privileged fields on creation
        && request.resource.data.get('tier', 'BASIC') == 'BASIC'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('accountStatus', 'ACTIVE') == 'ACTIVE'
        && request.resource.data.get('isVerified', false) == false;
      allow update: if isOwner(uid)
        // Prevent self-promotion to Admin, bypassing Active check, or forging Tier
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'accountStatus', 'tier']);
      allow delete: if isAdmin();

      // Cart items owned by user
      match /cart/{itemId} {
        allow read: if isSignedIn() && isOwner(uid);
        allow write: if isSignedIn() && isOwner(uid) && isActive();
      }

      // Bookmarks owned by user
      match /bookmarks/{contentId} {
        allow read: if isSignedIn() && isOwner(uid);
        allow write: if isSignedIn() && isOwner(uid) && isActive();
      }
    }

    // ── Profiles ───────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isActive()
        // Prevent forgery of authoritative social/commerce counters
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['followerCount', 'followingCount', 'shopCount', 'postCount',
                     'activeListingCount', 'reputationScore', 'tier', 'totalDeliveries']);
    }

    // ── Shops ──────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;  // public
      // Created via Cloud Function only to enforce tier limits
      allow create: if false;
      allow update: if isSignedIn() && isActive()
        && resource.data.ownerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'isVerified', 'listingCount']);

      allow delete: if isAdmin();
    }

    // ── Listings ───────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if true;  // public
      // Created and deleted via Cloud Function only to enforce tier limits
      allow create: if false;
      allow update: if isSignedIn()
        && ( (resource.data.sellerId == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['sellerId', 'isSponsored', 'commitmentCount',
                           'reservedQuantity', 'availableQuantity', 'stockQuantity'])
              && (request.resource.data.get('totalQuantity', 0) >= resource.data.get('reservedQuantity', 0)))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookmarkCount'])) );
      allow delete: if false;
    }


    // ── Reservations ───────────────────────────────────────────────────────
    match /reservations/{resId} {
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      // All writes via Cloud Functions only
      allow write: if false;
    }

    // ── Posts ──────────────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isActive()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && isActive()
        && ( (resource.data.authorId == request.auth.uid
              && !request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['authorId', 'likeCount', 'commentCount', 'reshareCount', 'bookmarkCount', 'rankingScore']))
            || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['likeCount', 'commentCount', 'reshareCount', 'bookmarkCount'])) );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;


      // Likes subcollection
      match /likes/{uid} {
        allow read: if true;
        allow write: if isOwner(uid) && isActive();
      }
    }

    // ── Comments ───────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isActive()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.participants.values().hasAny([request.auth.uid])
            || resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      // Orders created server-side only (Cloud Function)
      allow create: if false;

      // Status updates via Cloud Function only
      allow update: if false;
      allow delete: if false;
    }

    // ── Wallets ────────────────────────────────────────────────────────────
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // All writes server-side only — no client wallet mutation
      allow write: if false;
    }

    // ── Ledger Entries ─────────────────────────────────────────────────────
    match /ledgerEntries/{entryId} {
      allow read: if isAdmin()
        || resource.data.debitAccount == request.auth.uid
        || resource.data.creditAccount == request.auth.uid;
      // Immutable — write only from admin SDK (Cloud Functions)
      allow write: if false;
    }

    // ── Wallet Transactions ────────────────────────────────────────────────
    match /walletTransactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // Created/updated server-side only
      allow write: if false;
    }

    // ── Conversations ──────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isActive()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
           .data.participantIds.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && isActive()
        && request.resource.data.senderId == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── Delivery Routes ────────────────────────────────────────────────────
    match /deliveryRoutes/{routeId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || resource.data.driverId == request.auth.uid
            || isAdmin());
      allow create: if false;  // Cloud Function only
      allow update: if isSignedIn()
        // Driver can update their own live location (flat lat/lng fields —
        // matches FirestoreDeliveryRoute on Android, not a nested map)
        && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['driverCurrentLocationLat', 'driverCurrentLocationLng']);
      allow delete: if false;
    }

    // ── Advertising Campaigns ──────────────────────────────────────────────
    match /advertisingCampaigns/{campaignId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActive()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'DRAFT';
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status in ['PAUSED'];
      allow delete: if false;
    }

    // ── Subscriptions ──────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;  // Cloud Function only
    }

    // ── Entitlements ────────────────────────────────────────────────────────
    match /entitlements/{entitlementId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;  // Server only
    }

    // ── Merchant Usage ──────────────────────────────────────────────────────
    match /merchantUsage/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false; // Server only
    }

    // ── Audit Logs ─────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;  // Admin SDK only
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn() && isActive();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActive()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // ── Idempotency ────────────────────────────────────────────────────────
    match /idempotencyKeys/{key} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
  }
}
