rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    function isActive() {
      // Robust check for DEV environment where claims and docs might be missing
      return request.auth.token.get('active', true) == true &&
             (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('accountStatus', 'ACTIVE') == 'ACTIVE');
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // P0: Private Account Data - restricted to Owner/Admin
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        // P0-B: Prevent forgery of privileged fields on creation
        && request.resource.data.get('tier', 'BASIC') == 'BASIC'
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('accountStatus', 'ACTIVE') == 'ACTIVE'
        && request.resource.data.get('isVerified', false) == false
        // STRICT BOOTSTRAP: Only permit essential profile fields
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'photoUrl',
          'tier', 'isAdmin', 'isVerified', 'accountStatus',
          'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        // Prevent self-promotion to Admin, bypassing Active check, or forging Tier
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['isAdmin', 'accountStatus', 'tier']);
      allow delete: if isAdmin();

      // Cart items owned by user
      match /cart/{itemId} {
        allow read: if isSignedIn() && isOwner(uid);
        allow write: if isSignedIn() && isOwner(uid) && isActive();
      }

      // Bookmarks owned by user
      match /bookmarks/{bookmarkId} {
        allow read: if isSignedIn() && isOwner(uid);
        allow write: if isSignedIn() && isOwner(uid);
      }
    }

    // ── Profiles ───────────────────────────────────────────────────────────
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) && isActive()
        // Prevent forgery of authoritative social/commerce counters
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['followerCount', 'followingCount', 'shopCount', 'postCount',
                     'activeListingCount', 'reputationScore', 'tier', 'totalDeliveries']);
    }

    // ── Shops ──────────────────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if true;  // public
      // Created via Cloud Function only to enforce tier limits
      allow create: if false;
      // All shop updates must flow through Cloud Functions to ensure
      // authoritative field protection (ownerId, isVerified, etc).
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Listings ───────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if true;  // public
      // Created and deleted via Cloud Function only to enforce tier limits
      allow create: if false;
      allow update: if isSignedIn()
        && resource.data.sellerId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['id', 'sellerId', 'shopId', 'listingType', 'priceMinorUnits', 'priceCurrency', 'stockQuantity', 'isSponsored', 'commitmentCount', 'likeCount', 'commentCount', 'bookmarkCount', 'rankingScore', 'createdAt', 'updatedAt']);
      allow delete: if false;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // --- Posts -----------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;
      allow create: if false; // Cloud Function only (Harden Publish)
      allow update: if isSignedIn() && isActive()
        && resource.data.authorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['id', 'authorId', 'isSponsored', 'likeCount', 'commentCount', 'bookmarkCount', 'reshareCount', 'rankingScore', 'createdAt', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }
    }

    // ── Comments ───────────────────────────────────────────────────────────
    match /comments/{commentId} {
      allow read: if true;
      // All comment mutations (create/delete) must flow through Cloud Functions
      // to ensure atomic counter updates and server-side verification.
      allow write: if false;
    }

    // ── Orders ─────────────────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.sellerId == request.auth.uid
            || isAdmin());
      // Orders created server-side only (Cloud Function)
      allow create: if false;
      // Status updates via Cloud Function only
      allow update: if false;
      allow delete: if false;
    }

    // ── Delivery Requests ──────────────────────────────────────────────────
    match /deliveryRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.requesterId == request.auth.uid
            || resource.data.merchantId == request.auth.uid
            || isAdmin());
      // Created, accepted, declined, and expired via Cloud Function only —
      // the 120-second window is server-authoritative, not client-trusted.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── Wallets ────────────────────────────────────────────────────────────
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // All writes server-side only — no client wallet mutation
      allow write: if false;
    }

    // ── Ledger Entries ─────────────────────────────────────────────────────
    match /ledgerEntries/{entryId} {
      allow read: if isAdmin()
        || resource.data.debitAccount == request.auth.uid
        || resource.data.creditAccount == request.auth.uid;
      // Immutable — write only from admin SDK (Cloud Functions)
      allow write: if false;
    }

    // ── Wallet Transactions ────────────────────────────────────────────────
    match /walletTransactions/{txId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // Created/updated server-side only
      allow write: if false;
    }

    // ── Conversations ──────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isActive()
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }

    // ── Messages ───────────────────────────────────────────────────────────
    match /messages/{messageId} {
      allow read: if isSignedIn()
        && get(/databases/$(database)/documents/conversations/$(resource.data.conversationId))
           .data.participantIds.hasAny([request.auth.uid]);
      allow create: if isSignedIn() && isActive()
        && request.resource.data.senderId == request.auth.uid
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
           .data.participantIds.hasAny([request.auth.uid]);
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    // ── Delivery Routes ────────────────────────────────────────────────────
    match /deliveryRoutes/{routeId} {
      allow read: if isSignedIn()
        && (resource.data.buyerId == request.auth.uid
            || resource.data.driverId == request.auth.uid
            || isAdmin());
      allow create: if false;  // Cloud Function only
      allow update: if isSignedIn()
        // Driver can update their own live location (flat lat/lng fields —
        // matches FirestoreDeliveryRoute on Android, not a nested map)
        && resource.data.driverId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['driverCurrentLocationLat', 'driverCurrentLocationLng']);
      allow delete: if false;
    }

    // ── Advertising Campaigns ──────────────────────────────────────────────
    match /advertisingCampaigns/{campaignId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActive()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'DRAFT';
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status'])
        && request.resource.data.status in ['PAUSED'];
      allow delete: if false;
    }

    // ── Subscriptions ──────────────────────────────────────────────────────
    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;  // Cloud Function only
    }

    // ── Entitlements ────────────────────────────────────────────────────────
    match /entitlements/{entitlementId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;  // Server only
    }

    // ── Audit Logs ─────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;  // Admin SDK only
    }

    // ── Reports ────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if isSignedIn() && isActive();
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Follows ────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActive()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
    }

    // ── Idempotency ────────────────────────────────────────────────────────
    match /idempotencyKeys/{key} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── Reservations ───────────────────────────────────────────────────────
    // Reservations are an internal server implementation detail.
    // Documents carry: id, orderId, listingId, quantity, status, expiresAt, createdAt.
    // No buyerId/sellerId fields exist on reservation documents.
    // All reads and writes are performed by Cloud Functions via admin SDK.
    // Client apps read order status from the orders collection, not here.
    match /reservations/{resId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Function only
    }
  }
}