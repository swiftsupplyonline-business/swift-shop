rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /media/{userId}/{assetId} {
      // Marketplace listing media is publicly readable
      allow read: if true;

      // Only the authenticated owner can upload to their directory.
      // Strict caps: 5MB for images (optimized), 50MB for reels.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && ((request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
                       || (request.resource.contentType.matches('video/.*') && request.resource.size < 50 * 1024 * 1024));
    }
  }
}
