{
    "functions": {
        "source": "functions",
        "codebase": "default",
        "ignore": [
            "node_modules",
            ".git",
            "firebase-debug.log",
            "firebase-debug.*.log"
        ],
        "predeploy": [
            "npm --prefix functions run build"
        ]
    },
    "firestore": {
        "rules": "docs/firestore.rules",
        "indexes": "docs/firestore.indexes.json"
    },
    "storage": {
        "rules": "docs/storage.rules"
    },
    "hosting": {
        "public": "hosting",
        "ignore": [
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/marketplace",
                "function": "publicMarketplace"
            },
            {
                "source": "/pay/**",
                "function": "payPreview"
            },
            {
                "source": "/d/**",
                "function": "renderSharedDelivery"
            },
            {
                "source": "/s/**",
                "function": "renderSharedListing"
            },
            {
                "source": "/listing/**",
                "function": "renderListingPreview"
            },
            {
                "source": "/shop/**",
                "function": "renderShopPreview"
            },
            {
                "source": "/market",
                "destination": "/index.html"
            },
            {
                "source": "/cart",
                "destination": "/index.html"
            },
            {
                "source": "/checkout",
                "destination": "/index.html"
            }
        ]
    }
}
