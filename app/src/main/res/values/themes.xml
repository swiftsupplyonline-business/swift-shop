<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — Compose handles all visual theming -->
    <style name="Theme.SwiftShop" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Splash screen theme — shown before Compose loads -->
    <style name="Theme.SwiftShop.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D1B3E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SwiftShop</item>
    </style>
</resources>
